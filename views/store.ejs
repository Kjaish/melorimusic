<%- include('partials/header', { user: typeof user !== 'undefined' ? user : null }) %>

<style>
  :root {
    --store-primary: <%= storefront.primary_color || '#FF5500' %>;
  }
  .store-hero {
    position: relative;
    min-height: 300px;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 3rem 1.5rem;
  }
  .store-hero-bg {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: <% if (storefront.banner_url) { %>url('/uploads/<%= storefront.banner_url %>') center/cover no-repeat<% } else { %>linear-gradient(135deg, var(--store-primary), #1a1a1a)<% } %>;
  }
  .store-hero-overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: linear-gradient(to bottom, rgba(0,0,0,0.5), rgba(0,0,0,0.8));
  }
  .store-hero-content {
    position: relative;
    z-index: 1;
    max-width: 800px;
  }
  .store-logo {
    width: 120px;
    height: 120px;
    border-radius: 50%;
    object-fit: cover;
    border: 4px solid white;
    margin-bottom: 1.5rem;
    box-shadow: 0 4px 20px rgba(0,0,0,0.3);
  }
  .store-logo-placeholder {
    width: 120px;
    height: 120px;
    border-radius: 50%;
    background: var(--store-primary);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 3rem;
    color: white;
    margin: 0 auto 1.5rem;
    border: 4px solid white;
    box-shadow: 0 4px 20px rgba(0,0,0,0.3);
  }
  .store-name {
    font-size: 2.5rem;
    font-weight: bold;
    margin-bottom: 0.5rem;
    color: white;
  }
  .store-description {
    color: rgba(255,255,255,0.8);
    font-size: 1.1rem;
    max-width: 600px;
    margin: 0 auto;
  }
  .store-section {
    padding: 3rem 0;
  }
  .store-section-title {
    font-size: 1.75rem;
    margin-bottom: 1.5rem;
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .store-section-title i {
    color: var(--store-primary);
  }
  .album-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 1.5rem;
  }
  .store-album-card {
    background: var(--card-background);
    border-radius: 12px;
    overflow: hidden;
    transition: transform 0.3s, box-shadow 0.3s;
  }
  .store-album-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 10px 30px rgba(0,0,0,0.3);
  }
  .store-album-art {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
  }
  .store-album-info {
    padding: 1rem;
  }
  .store-album-title {
    font-weight: 600;
    margin-bottom: 0.25rem;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .store-album-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    color: var(--text-secondary);
    font-size: 0.875rem;
  }
  .store-album-price {
    color: var(--store-primary);
    font-weight: bold;
  }
  .store-btn {
    background: var(--store-primary);
    color: white;
    padding: 0.5rem 1rem;
    border-radius: 20px;
    text-decoration: none;
    font-size: 0.875rem;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    transition: opacity 0.3s;
  }
  .store-btn:hover {
    opacity: 0.9;
  }
  .singles-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1rem;
  }
  .single-item {
    background: var(--card-background);
    border-radius: 10px;
    padding: 1rem;
    display: flex;
    align-items: center;
    gap: 1rem;
    transition: background 0.2s;
  }
  .single-item:hover {
    background: #2a2a2a;
  }
  .single-art {
    width: 60px;
    height: 60px;
    border-radius: 8px;
    object-fit: cover;
    flex-shrink: 0;
  }
  .single-art-placeholder {
    width: 60px;
    height: 60px;
    border-radius: 8px;
    background: linear-gradient(135deg, #333, #222);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .single-info {
    flex: 1;
    min-width: 0;
  }
  .single-title {
    font-weight: 500;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .single-price {
    color: var(--store-primary);
    font-weight: bold;
    font-size: 0.875rem;
  }
  .empty-state {
    text-align: center;
    padding: 3rem;
    color: var(--text-secondary);
  }
  .empty-state i {
    font-size: 3rem;
    margin-bottom: 1rem;
    opacity: 0.5;
  }
</style>

<div class="store-hero" data-testid="store-hero">
  <div class="store-hero-bg"></div>
  <div class="store-hero-overlay"></div>
  <div class="store-hero-content">
    <% if (storefront.logo_url) { %>
      <img src="/uploads/<%= storefront.logo_url %>" alt="<%= storefront.name %>" class="store-logo" data-testid="img-store-logo">
    <% } else { %>
      <div class="store-logo-placeholder">
        <i class="fas fa-music"></i>
      </div>
    <% } %>
    <h1 class="store-name" data-testid="text-store-name"><%= storefront.name %></h1>
    <% if (storefront.description) { %>
      <p class="store-description" data-testid="text-store-description"><%= storefront.description %></p>
    <% } %>
  </div>
</div>

<main class="container" style="padding: 1.5rem 1rem; padding-bottom: 100px;">
  <% if (albums && albums.length > 0) { %>
    <section class="store-section">
      <h2 class="store-section-title"><i class="fas fa-compact-disc"></i> Albums</h2>
      <div class="album-grid">
        <% albums.forEach(album => { %>
          <a href="/album/<%= album.id %>" class="store-album-card" data-testid="card-album-<%= album.id %>">
            <img src="/uploads/album_art/<%= album.album_art || 'default.jpg' %>" alt="<%= album.title %>" class="store-album-art" onerror="this.src='/uploads/album_art/default.jpg'">
            <div class="store-album-info">
              <div class="store-album-title" data-testid="text-album-title-<%= album.id %>"><%= album.title %></div>
              <div class="store-album-meta">
                <span><%= album.song_count || 0 %> tracks</span>
                <span class="store-album-price" data-testid="text-album-price-<%= album.id %>">$<%= parseFloat(album.price).toFixed(2) %></span>
              </div>
            </div>
          </a>
        <% }); %>
      </div>
    </section>
  <% } %>
  
  <% if (singles && singles.length > 0) { %>
    <section class="store-section">
      <h2 class="store-section-title"><i class="fas fa-music"></i> Singles</h2>
      <div class="singles-grid">
        <% singles.forEach(single => { %>
          <div class="single-item" data-testid="card-single-<%= single.id %>">
            <% if (single.cover_art) { %>
              <img src="/uploads/album_art/<%= single.cover_art %>" alt="<%= single.title %>" class="single-art">
            <% } else { %>
              <div class="single-art-placeholder">
                <i class="fas fa-music" style="color: #666;"></i>
              </div>
            <% } %>
            <div class="single-info">
              <div class="single-title" data-testid="text-single-title-<%= single.id %>"><%= single.title %></div>
              <div class="single-price" data-testid="text-single-price-<%= single.id %>">$<%= parseFloat(single.price).toFixed(2) %></div>
            </div>
            <a href="/purchase/song/<%= single.id %>" class="store-btn" data-testid="button-buy-single-<%= single.id %>">
              <i class="fas fa-shopping-cart"></i> Buy
            </a>
          </div>
        <% }); %>
      </div>
    </section>
  <% } %>
  
  <% if ((!albums || albums.length === 0) && (!singles || singles.length === 0)) { %>
    <div class="empty-state">
      <i class="fas fa-music"></i>
      <h2>No Music Available Yet</h2>
      <p>Check back soon for new releases!</p>
    </div>
  <% } %>
</main>

<%- include('partials/footer-simple') %>

<script src="/js/main.js"></script>
