<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Purchase Successful - MELORI MUSIC</title>
  <link rel="stylesheet" href="/css/style.css">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
</head>
<body>
  <div class="success-page">
    <div class="success-modal-backdrop"></div>
    <div class="success-container" data-testid="modal-purchase-success">
      <div class="success-icon">
        <i class="fas fa-check-circle"></i>
      </div>
      <h1>Purchase Successful!</h1>
      <p class="success-message">
        Thank you for purchasing 
        <strong><%= item ? item.title : 'this item' %></strong>
      </p>
      
      <div class="download-status" id="downloadStatus">
        <i class="fas fa-spinner fa-spin"></i>
        <span>Preparing your download...</span>
      </div>
      
      <p class="email-notice">
        <i class="fas fa-envelope"></i>
        A confirmation email with your download link has been sent to 
        <strong><%= email %></strong>
      </p>
      
      <div class="purchase-details">
        <% if (type === 'album' && item) { %>
          <div class="album-info">
            <% if (item.album_art) { %>
              <img src="/uploads/album_art/<%= item.album_art %>" alt="<%= item.title %>" class="album-cover">
            <% } %>
            <div class="album-text">
              <h3><%= item.title %></h3>
              <p><%= item.description || '' %></p>
            </div>
          </div>
        <% } else if (type === 'song' && item) { %>
          <div class="song-info">
            <i class="fas fa-music"></i>
            <h3><%= item.title %></h3>
          </div>
        <% } %>
      </div>
      
      <div class="success-actions">
        <% if (typeof saleId !== 'undefined' && saleId) { %>
          <a href="/download/<%= saleId %>" class="btn btn-download" id="downloadBtn" data-testid="link-download">
            <i class="fas fa-download"></i> Download Your Music
          </a>
        <% } %>
        <a href="/music" class="btn btn-primary" data-testid="link-browse-music">
          <i class="fas fa-music"></i> Browse More Music
        </a>
        <a href="/" class="btn btn-secondary" data-testid="link-home">Back to Home</a>
      </div>
      
      <p class="download-note">
        <i class="fas fa-info-circle"></i>
        Your download should start automatically. If it doesn't, click the download button above.
      </p>
    </div>
  </div>

  <style>
    .success-page {
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      background: linear-gradient(135deg, var(--bg-color) 0%, #1a1a1a 100%);
      padding: 2rem;
      position: relative;
    }
    
    .success-modal-backdrop {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: rgba(0, 0, 0, 0.7);
      z-index: 1;
    }
    
    .success-container {
      background: var(--card-bg);
      border-radius: 16px;
      padding: 3rem;
      max-width: 520px;
      width: 100%;
      text-align: center;
      box-shadow: 0 25px 80px rgba(255, 85, 0, 0.2), 0 20px 60px rgba(0, 0, 0, 0.4);
      position: relative;
      z-index: 2;
      animation: slideIn 0.4s ease-out;
      border: 1px solid rgba(255, 85, 0, 0.3);
    }
    
    @keyframes slideIn {
      from {
        opacity: 0;
        transform: translateY(-30px) scale(0.95);
      }
      to {
        opacity: 1;
        transform: translateY(0) scale(1);
      }
    }
    
    .success-icon {
      font-size: 5rem;
      color: #4CAF50;
      margin-bottom: 1.5rem;
      animation: checkPop 0.5s ease-out 0.2s both;
    }
    
    @keyframes checkPop {
      from {
        transform: scale(0);
      }
      50% {
        transform: scale(1.2);
      }
      to {
        transform: scale(1);
      }
    }
    
    .success-container h1 {
      color: var(--text-color);
      margin-bottom: 1rem;
      font-size: 2rem;
    }
    
    .success-message {
      color: var(--text-muted);
      font-size: 1.1rem;
      margin-bottom: 1rem;
    }
    
    .success-message strong {
      color: var(--primary);
    }
    
    .download-status {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0.75rem;
      padding: 1rem;
      background: rgba(76, 175, 80, 0.15);
      border-radius: 8px;
      margin-bottom: 1.5rem;
      color: #4CAF50;
      font-weight: 500;
    }
    
    .download-status.complete {
      background: rgba(76, 175, 80, 0.2);
    }
    
    .download-status.complete i {
      animation: none;
    }
    
    .email-notice {
      color: var(--text-muted);
      font-size: 0.95rem;
      margin-bottom: 1.5rem;
      padding: 1rem;
      background: rgba(255, 85, 0, 0.1);
      border-radius: 8px;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;
      flex-wrap: wrap;
    }
    
    .email-notice i {
      color: var(--primary);
    }
    
    .email-notice strong {
      color: var(--text-color);
    }
    
    .purchase-details {
      margin-bottom: 2rem;
    }
    
    .album-info {
      display: flex;
      align-items: center;
      gap: 1rem;
      padding: 1rem;
      background: rgba(255, 255, 255, 0.05);
      border-radius: 8px;
    }
    
    .album-cover {
      width: 80px;
      height: 80px;
      object-fit: cover;
      border-radius: 8px;
    }
    
    .album-text {
      text-align: left;
    }
    
    .album-text h3 {
      color: var(--text-color);
      margin-bottom: 0.25rem;
    }
    
    .album-text p {
      color: var(--text-muted);
      font-size: 0.9rem;
    }
    
    .song-info {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0.75rem;
      padding: 1rem;
      background: rgba(255, 255, 255, 0.05);
      border-radius: 8px;
    }
    
    .song-info i {
      color: var(--primary);
      font-size: 1.5rem;
    }
    
    .song-info h3 {
      color: var(--text-color);
      margin: 0;
    }
    
    .success-actions {
      display: flex;
      gap: 1rem;
      justify-content: center;
      flex-wrap: wrap;
      margin-bottom: 1.5rem;
    }
    
    .success-actions .btn {
      padding: 0.75rem 1.5rem;
      border-radius: 8px;
      text-decoration: none;
      font-weight: 600;
      transition: transform 0.2s, box-shadow 0.2s;
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
    }
    
    .success-actions .btn:hover {
      transform: translateY(-2px);
    }
    
    .btn-primary {
      background: var(--primary);
      color: white;
    }
    
    .btn-secondary {
      background: transparent;
      border: 2px solid var(--primary);
      color: var(--primary);
    }
    
    .btn-download {
      background: linear-gradient(135deg, #4CAF50 0%, #45a049 100%);
      color: white;
      font-size: 1.1rem;
      padding: 1rem 2rem;
      box-shadow: 0 4px 15px rgba(76, 175, 80, 0.3);
    }
    
    .btn-download:hover {
      box-shadow: 0 6px 20px rgba(76, 175, 80, 0.4);
    }
    
    .download-note {
      color: var(--text-muted);
      font-size: 0.85rem;
      opacity: 0.8;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;
    }
    
    .download-note i {
      color: var(--primary);
    }
    
    @media (max-width: 480px) {
      .success-container {
        padding: 2rem;
        margin: 1rem;
      }
      
      .success-icon {
        font-size: 4rem;
      }
      
      .success-container h1 {
        font-size: 1.5rem;
      }
      
      .btn-download {
        width: 100%;
        justify-content: center;
      }
    }
  </style>

  <script>
    // Auto-download on page load
    document.addEventListener('DOMContentLoaded', function() {
      const downloadBtn = document.getElementById('downloadBtn');
      const downloadStatus = document.getElementById('downloadStatus');
      
      if (downloadBtn) {
        // Start download automatically after a short delay
        setTimeout(function() {
          // Update status
          downloadStatus.innerHTML = '<i class="fas fa-check-circle"></i><span>Download starting...</span>';
          downloadStatus.classList.add('complete');
          
          // Navigate to download page in a new tab to trigger download
          window.open(downloadBtn.href, '_blank');
          
          // Update status after download initiated
          setTimeout(function() {
            downloadStatus.innerHTML = '<i class="fas fa-check-circle"></i><span>Download initiated! Check your downloads folder.</span>';
          }, 1000);
        }, 1500);
      } else {
        // No download available
        downloadStatus.innerHTML = '<i class="fas fa-info-circle"></i><span>Check your email for download links.</span>';
        downloadStatus.classList.add('complete');
      }
    });
  </script>
</body>
</html>
