<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Error - MELORI MUSIC</title>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body>
  <%- include('partials/header') %>
  
  <main class="container">
    <div style="text-align: center; padding: 4rem 0;">
      <i class="fas fa-exclamation-triangle" style="font-size: 4rem; color: #ff5500; margin-bottom: 1rem; display: block;"></i>
      <h1>Something went wrong</h1>
      <p><%= typeof message !== 'undefined' ? message : 'An unexpected error occurred' %></p>
      <a href="/" class="btn btn-primary" style="margin-top: 2rem;" data-testid="link-back-home">
        <i class="fas fa-home"></i> Back to Home
      </a>
    </div>
  </main>
</body>
</html>
