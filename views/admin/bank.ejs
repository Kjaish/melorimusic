<%- include('../partials/header', { user: user }) %>

<main class="container" style="padding: 1.5rem 1rem; padding-bottom: 100px;">
  <h1 style="margin-bottom: 2rem;"><i class="fas fa-university"></i> Bank Account Setup</h1>
  
  <% if (typeof success !== 'undefined' && success === 'connected') { %>
    <div class="alert alert-success" style="background: #10b981; color: white; padding: 1rem; border-radius: 8px; margin-bottom: 1.5rem;">
      <i class="fas fa-check-circle"></i> Your bank account has been successfully connected! You can now receive payouts.
    </div>
  <% } %>
  
  <% if (typeof pending !== 'undefined' && pending === 'true') { %>
    <div class="alert alert-warning" style="background: #f59e0b; color: white; padding: 1rem; border-radius: 8px; margin-bottom: 1.5rem;">
      <i class="fas fa-exclamation-triangle"></i> Your bank account setup is incomplete. Please complete the verification process to receive payouts.
    </div>
  <% } %>
  
  <% if (typeof error !== 'undefined' && error) { %>
    <% if (error === 'connect_not_enabled') { %>
      <div class="alert alert-warning" style="background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%); color: white; padding: 1.5rem; border-radius: 12px; margin-bottom: 1.5rem;">
        <div style="display: flex; align-items: flex-start; gap: 1rem;">
          <i class="fas fa-exclamation-triangle" style="font-size: 1.5rem; margin-top: 0.25rem;"></i>
          <div>
            <h3 style="margin: 0 0 0.5rem 0; font-size: 1.1rem;">Stripe Connect Setup Required</h3>
            <p style="margin: 0 0 1rem 0; opacity: 0.95;">
              The platform administrator needs to enable Stripe Connect before artists can receive payouts.
            </p>
            <div style="background: rgba(255,255,255,0.15); padding: 1rem; border-radius: 8px; font-size: 0.9rem;">
              <strong>Admin Instructions:</strong>
              <ol style="margin: 0.5rem 0 0 1rem; padding: 0; line-height: 1.8;">
                <li>Go to <a href="https://dashboard.stripe.com/connect/accounts/overview" target="_blank" style="color: white; text-decoration: underline;">Stripe Connect Dashboard</a></li>
                <li>Click "Get started with Connect"</li>
                <li>Choose "Platform or marketplace"</li>
                <li>Select "Express" account type</li>
                <li>Complete the setup and return here</li>
              </ol>
            </div>
          </div>
        </div>
      </div>
    <% } else { %>
      <div class="alert alert-danger" style="background: #ef4444; color: white; padding: 1rem; border-radius: 8px; margin-bottom: 1.5rem;">
        <i class="fas fa-times-circle"></i> 
        <% if (error === 'no_account') { %>
          No bank account found. Please start the setup process.
        <% } else if (error === 'verification_failed') { %>
          Verification failed. Please try again or contact support.
        <% } else if (error === 'setup_failed') { %>
          Unable to start bank account setup. Please try again later.
        <% } else { %>
          An error occurred. Please try again.
        <% } %>
      </div>
    <% } %>
  <% } %>
  
  <div class="form-container">
    <div class="alert alert-info" style="background: var(--card-background); border: 1px solid var(--border-color); padding: 1.5rem; border-radius: 10px; margin-bottom: 1.5rem;">
      <i class="fas fa-shield-alt" style="color: var(--primary-color);"></i>
      <strong>Secure Bank Setup</strong>
      <p style="margin-top: 0.5rem; margin-bottom: 0; color: var(--text-secondary);">
        Your banking information is securely handled by Stripe. MELORI never stores your bank account details directly.
      </p>
    </div>
    
    <% if (typeof connectStatus !== 'undefined' && connectStatus && connectStatus.connected && connectStatus.details_submitted) { %>
      <div style="padding: 2rem; background: linear-gradient(135deg, #10b981 0%, #059669 100%); border-radius: 12px; color: white; margin-bottom: 2rem;">
        <div style="display: flex; align-items: center; gap: 1rem; margin-bottom: 1rem;">
          <i class="fas fa-check-circle" style="font-size: 2.5rem;"></i>
          <div>
            <h2 style="margin: 0; font-size: 1.5rem;">Bank Account Connected</h2>
            <p style="margin: 0.25rem 0 0 0; opacity: 0.9;">Your payout information is set up and verified</p>
          </div>
        </div>
        
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 1rem; margin-top: 1.5rem;">
          <div style="background: rgba(255,255,255,0.1); padding: 1rem; border-radius: 8px;">
            <i class="fas fa-<%= connectStatus.payouts_enabled ? 'check' : 'clock' %>"></i>
            <span style="margin-left: 0.5rem;">Payouts: <%= connectStatus.payouts_enabled ? 'Enabled' : 'Pending' %></span>
          </div>
          <div style="background: rgba(255,255,255,0.1); padding: 1rem; border-radius: 8px;">
            <i class="fas fa-<%= connectStatus.charges_enabled ? 'check' : 'clock' %>"></i>
            <span style="margin-left: 0.5rem;">Charges: <%= connectStatus.charges_enabled ? 'Enabled' : 'Pending' %></span>
          </div>
        </div>
        
        <div style="margin-top: 1.5rem;">
          <a href="/artist/connect/dashboard" class="btn" style="background: white; color: #059669; padding: 0.75rem 1.5rem; border-radius: 8px; text-decoration: none; display: inline-flex; align-items: center; gap: 0.5rem;" data-testid="link-stripe-dashboard">
            <i class="fas fa-external-link-alt"></i> View Stripe Dashboard
          </a>
        </div>
      </div>
      
    <% } else if (typeof connectStatus !== 'undefined' && connectStatus && connectStatus.connected && !connectStatus.details_submitted) { %>
      <div style="padding: 2rem; background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%); border-radius: 12px; color: white; margin-bottom: 2rem;">
        <div style="display: flex; align-items: center; gap: 1rem; margin-bottom: 1rem;">
          <i class="fas fa-exclamation-triangle" style="font-size: 2.5rem;"></i>
          <div>
            <h2 style="margin: 0; font-size: 1.5rem;">Setup Incomplete</h2>
            <p style="margin: 0.25rem 0 0 0; opacity: 0.9;">Please complete your bank account verification to receive payouts</p>
          </div>
        </div>
        
        <div style="margin-top: 1.5rem;">
          <a href="/artist/connect/onboard" class="btn" style="background: white; color: #d97706; padding: 0.75rem 1.5rem; border-radius: 8px; text-decoration: none; display: inline-flex; align-items: center; gap: 0.5rem; font-weight: 600;" data-testid="button-complete-setup">
            <i class="fas fa-arrow-right"></i> Complete Setup
          </a>
        </div>
      </div>
      
      <div class="alert alert-warning" style="background: #fef3c7; border: 1px solid #f59e0b; padding: 1rem; border-radius: 8px; color: #92400e;">
        <i class="fas fa-info-circle"></i>
        <strong>Payouts Disabled:</strong> You won't be able to receive earnings until you complete the bank account verification process.
      </div>
      
    <% } else { %>
      <div style="padding: 2rem; background: var(--card-background); border: 2px dashed var(--border-color); border-radius: 12px; text-align: center; margin-bottom: 2rem;">
        <i class="fas fa-university" style="font-size: 3rem; color: var(--text-secondary); margin-bottom: 1rem;"></i>
        <h2 style="margin: 0 0 0.5rem 0;">No Bank Account Connected</h2>
        <p style="color: var(--text-secondary); margin-bottom: 1.5rem;">
          Connect your bank account to receive payouts from your music sales
        </p>
        
        <a href="/artist/connect/onboard" class="btn btn-primary" style="padding: 1rem 2rem; font-size: 1.1rem; display: inline-flex; align-items: center; gap: 0.5rem;" data-testid="button-start-setup">
          <i class="fab fa-stripe"></i> Connect Bank Account
        </a>
        
        <p style="color: var(--text-secondary); font-size: 0.875rem; margin-top: 1rem;">
          Powered by <strong>Stripe</strong> for secure payments
        </p>
      </div>
      
      <div class="alert alert-warning" style="background: #fef3c7; border: 1px solid #f59e0b; padding: 1rem; border-radius: 8px; color: #92400e;">
        <i class="fas fa-exclamation-triangle"></i>
        <strong>Required for Payouts:</strong> You must connect a bank account to receive earnings from your music sales on MELORI.
      </div>
    <% } %>
    
    <div style="margin-top: 2rem; padding: 1.5rem; background: var(--card-background); border-radius: 10px; border: 1px solid var(--border-color);">
      <h3 style="margin: 0 0 1rem 0;"><i class="fas fa-question-circle"></i> How it works</h3>
      <ul style="margin: 0; padding-left: 1.5rem; color: var(--text-secondary); line-height: 1.8;">
        <li>Click "Connect Bank Account" to securely set up your payout information</li>
        <li>You'll be redirected to Stripe's secure onboarding page</li>
        <li>Complete the identity verification and bank account details</li>
        <li>Once verified, you'll automatically receive payouts based on your plan</li>
        <li>Your bank details are stored securely by Stripe, never on MELORI servers</li>
      </ul>
    </div>
    
    <div style="margin-top: 1.5rem; padding: 1.5rem; background: var(--card-background); border-radius: 10px; border: 1px solid var(--border-color);">
      <h3 style="margin: 0 0 1rem 0;"><i class="fas fa-money-bill-wave"></i> Payout Schedule</h3>
      <p style="color: var(--text-secondary); margin: 0;">
        Payouts are processed according to your subscription plan:
      </p>
      <ul style="margin: 0.5rem 0 0 0; padding-left: 1.5rem; color: var(--text-secondary); line-height: 1.8;">
        <li><strong>Creator (Free):</strong> Monthly payouts, $10 minimum</li>
        <li><strong>Pro:</strong> Weekly payouts, no minimum</li>
        <li><strong>Label:</strong> Weekly payouts, no minimum, priority processing</li>
      </ul>
    </div>
  </div>
</main>

<%- include('../partials/footer-simple') %>

<script src="/js/main.js"></script>
