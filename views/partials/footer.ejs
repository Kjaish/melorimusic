<div class="audio-player" id="audioPlayer">
  <div class="player-controls">
    <button id="prevBtn" class="play-btn" data-testid="button-player-prev">
      <i class="fas fa-step-backward"></i>
    </button>
    <button id="playBtn" class="play-btn" data-testid="button-player-play">
      <i class="fas fa-play"></i>
    </button>
    <button id="nextBtn" class="play-btn" data-testid="button-player-next">
      <i class="fas fa-step-forward"></i>
    </button>
  </div>
  
  <div class="player-info">
    <div id="currentSongTitle" data-testid="text-current-song">No song selected</div>
    <div id="currentSongAlbum" style="font-size: 0.8rem; color: #999;"></div>
  </div>
  
  <div class="player-progress">
    <div class="progress-bar" id="progressBar">
      <div class="progress-fill" id="progressFill"></div>
    </div>
    <div style="display: flex; justify-content: space-between; font-size: 0.8rem; margin-top: 0.25rem;">
      <span id="currentTime">0:00</span>
      <span id="duration">0:00</span>
    </div>
  </div>
  
  <div class="player-volume">
    <i class="fas fa-volume-up" style="margin-right: 0.5rem;"></i>
    <input type="range" id="volumeSlider" min="0" max="100" value="50" style="width: 100px;" data-testid="input-volume">
  </div>
</div>

<div id="purchaseModal" class="modal">
  <div class="modal-content">
    <button class="close-modal" id="closeModalBtn" data-testid="button-modal-close">&times;</button>
    <h2 id="modalTitle">Purchase</h2>
    <form id="purchaseForm">
      <input type="hidden" id="purchaseType" name="type">
      <input type="hidden" id="purchaseId" name="id">
      
      <div class="form-group">
        <label for="customerName">Your Name</label>
        <input type="text" id="customerName" name="name" class="form-control" required data-testid="input-customer-name">
      </div>
      
      <div class="form-group">
        <label for="customerEmail">Email Address</label>
        <input type="email" id="customerEmail" name="email" class="form-control" required data-testid="input-customer-email">
        <small style="color: var(--text-secondary);">Download link will be sent to this email</small>
      </div>
      
      <div class="form-group">
        <p style="font-size: 1.2rem;">Total: <strong id="purchasePrice" data-testid="text-purchase-price">$0.00</strong></p>
      </div>
      
      <button type="submit" class="btn btn-primary" style="width: 100%;" data-testid="button-complete-purchase">
        <i class="fas fa-shopping-cart"></i> Complete Purchase
      </button>
    </form>
  </div>
</div>

<footer>
  <div class="container">
    <p>&copy; <%= new Date().getFullYear() %> MELORI MUSIC. All rights reserved.</p>
    <p style="margin-top: 0.5rem; font-size: 0.9rem;">Karl Ray | Founder</p>
    <p style="margin-top: 0.5rem; font-size: 0.9rem;">High-quality music, delivered digitally.</p>
  </div>
</footer>

<script src="/js/right-nav.js"></script>
