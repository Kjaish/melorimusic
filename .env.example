# Application
NODE_ENV=development
PORT=5000
PUBLIC_BASE_URL=http://localhost:5000

# Database: use sqlite://./melori.db locally or a PostgreSQL connection string
DATABASE_URL=sqlite://./melori.db

# Authentication
SESSION_SECRET=replace-with-a-long-random-secret
ADMIN_PASSWORD=replace-with-a-local-admin-password
ADMIN_API_KEY=replace-with-a-local-admin-api-key

# Optional email / SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@example.com

# Optional payments
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional AI search
DEEPSEEK_API_KEY=

# Optional object storage
PUBLIC_OBJECT_SEARCH_PATHS=
PRIVATE_OBJECT_DIR=
